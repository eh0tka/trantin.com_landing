1:[["$","a",null,{"className":"skip-link","href":"#story","children":"Skip to the story"}],["$","header",null,{"className":"masthead shell","children":[["$","span",null,{"className":"wordmark","children":["Anton Trantin",["$","span",null,{"className":"orange","children":"."}],["$","span",null,{"className":"craft-byline","children":"Digital Craftsman"}]]}],["$","span",null,{"className":"masthead-note","children":"A WORK IN PROGRESS, SINCE 2003"}]]}],["$","main",null,{"children":[["$","section",null,{"className":"hero shell","aria-labelledby":"intro-title","children":[["$","div",null,{"className":"hero-copy","children":[["$","p",null,{"className":"eyebrow","children":"ENGINEER. ENTREPRENEUR. ANGEL INVESTOR."}],["$","figure",null,{"className":"portrait-note","children":[["$","img",null,{"src":"/portrait.png","alt":"Anton Trantin smiling","width":"250","height":"250","fetchPriority":"high"}],["$","figcaption",null,{"children":"Hi, I’m Antosha."}]]}],["$","h1",null,{"id":"intro-title","children":["For the joy",["$","br",null,{}],["$","em",null,{"children":"of making."}]]}],["$","p",null,{"className":"intro","children":"I build software, products, and sometimes companies. Some experiments fall apart. Others find a life of their own. I keep making things because I love the process—and seeing what they become."}],["$","a",null,{"className":"story-link","href":"#story","children":["A few chapters along the way ",["$","span",null,{"aria-hidden":"true","children":"↓"}]]}]]}],["$","div",null,{"className":"hero-foot","children":[["$","span",null,{"children":"THE THREAD SO FAR"}],["$","span",null,{"children":"2003 — PRESENT"}]]}]]}],["$","section",null,{"className":"timeline shell","id":"story","aria-label":"My story","children":[["$","$Ld",null,{}],["$","article",null,{"className":"chapter","children":[["$","div",null,{"className":"chapter-date","children":["2003–2009",["$","span",null,{"className":"chapter-index","children":"01 / THE BEGINNING"}]]}],["$","div",null,{"className":"chapter-body","children":[["$","h2",null,{"children":"Curiosity gets practical."}],["$","p",null,{"children":"I got hooked on technology in 2003. By 2006, I was writing low-level software and drivers for satellite ground stations. C++, assembly, and a very tangible connection between code and the real world."}],["$","p",null,{"children":"At Bauman Moscow State Technical University, my thesis took me to SIBERIA-2, an electron storage ring, to work on a micromechanical gyroscope-accelerometer."}],["$","p",null,{"className":"aside","children":"An unusually large machine. A very small device."}]]}]]}],["$","article",null,{"className":"chapter","children":[["$","div",null,{"className":"chapter-date","children":["2009–2015",["$","span",null,{"className":"chapter-index","children":"02 / THE REAL WORLD"}]]}],["$","div",null,{"className":"chapter-body","children":[["$","h2",null,{"children":["Software meets",["$","br",null,{}],"the real world."]}],["$","p",null,{"children":"Airport operations. Enterprise systems. Intelligent transport infrastructure for the 2014 Winter Olympics in Sochi. Different industries, different stacks, and software that had to work beyond a demo."}],["$","p",null,{"children":"I moved from writing code to designing systems and leading teams. Somewhere along the way, I realised that the hardest problems were often in communication and business, rather than the technology itself."}],["$","p",null,{"className":"aside","children":"The stack changes. That lesson holds up."}]]}]]}],["$","article",null,{"className":"chapter","children":[["$","div",null,{"className":"chapter-date","children":["2016–2019",["$","span",null,{"className":"chapter-index","children":"03 / INTO BUSINESS"}]]}],["$","div",null,{"className":"chapter-body","children":[["$","h2",null,{"children":["Learning to be",["$","br",null,{}],"a founder."]}],["$","p",null,{"children":"After studying software engineering at Innopolis University, I co-founded Innosoft and became deeply involved in building YORSO, a B2B platform for the seafood industry."}],["$","p",null,{"children":"I went from CTO to CEO, learning product, sales, fundraising, and company-building by doing them. The journey took us through the 500 Startups & Sberbank accelerator and to recognition at Fish 2.0, held at Stanford."}],"$Le"]}]]}],"$Lf","$L10","$L11"]}],"$L12","$L13"]}],"$L14"]
