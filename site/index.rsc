e:["$","p",null,{"className":"aside","children":"I knew software. There was a lot to learn about fish."}]
f:["$","article",null,{"className":"chapter","children":[["$","div",null,{"className":"chapter-date","children":["2020–2025",["$","span",null,{"className":"chapter-index","children":"04 / CONSUMER SCALE"}]]}],["$","div",null,{"className":"chapter-body","children":[["$","h2",null,{"children":["A much bigger",["$","br",null,{}],"everyday audience."]}],["$","p",null,{"children":"In 2020, I started building in the mass-market consumer space. Products for everyday use, reaching people around the world."}],["$","p",null,{"children":"That work grew into an international business, with companies operating in 11+ countries. The products reach users worldwide."}],["$","div",null,{"className":"cumulative","children":[["$","span",null,{"className":"big-number","children":["600M",["$","span",null,{"children":"+"}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"Cumulative installs"}],["$","span",null,{"children":"Since 2020, through today"}]]}]]}]]}]]}]
10:["$","article",null,{"className":"chapter chapter-investing","children":[["$","div",null,{"className":"chapter-date","children":["Along the way",["$","span",null,{"className":"chapter-index","children":"05 / PEOPLE"}]]}],["$","div",null,{"className":"chapter-body","children":[["$","h2",null,{"children":"Backing people."}],["$","p",null,{"className":"investing-statement","children":"I back entrepreneurs—the people doing the work."}],["$","p",null,{"children":"Angel investing has become another part of the journey. For me, it starts with the person building the business."}]]}]]}]
11:["$","article",null,{"className":"chapter chapter-now","children":[["$","div",null,{"className":"chapter-date","children":["2025–present",["$","span",null,{"className":"chapter-index","children":[["$","span",null,{"className":"now-dot"}],"06 / STILL BUILDING"]}]]}],["$","div",null,{"className":"chapter-body","children":[["$","h2",null,{"children":["Same curiosity.",["$","br",null,{}],["$","em",null,{"children":"New possibilities."}]]}],["$","p",null,{"children":"Since 2025, I’ve been building an AI-centric company and AI-centric products. Agents are part of how we work every day, alongside a team of five people."}],["$","p",null,{"children":"The tools have changed—from C++ and assembly to AI agents. The craft still means deciding what’s worth making, caring about the details, and bringing it into the world."}],["$","p",null,{"children":"We currently run ten live products, with five million daily active users—and the audience keeps growing. Everything is built in-house."}],["$","p",null,{"children":["For the soul, I started ",["$","strong",null,{"children":"1Buck Apps"}],": small everyday apps I make for myself and my friends. Private by design, high quality inside, with engineering and product soul. No ads, no trackers, fair prices. ",["$","a",null,{"href":"https://antosha.app/1buck-apps/","target":"_blank","rel":"noopener","children":["antosha.app ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","dl",null,{"className":"current-metrics","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Live products"}],["$","dd",null,{"children":"10"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Daily active users"}],["$","dd",null,{"children":"5M"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"People, fully in-house"}],["$","dd",null,{"children":"5"}]]}]]}],["$","p",null,{"className":"metric-caption","children":"The team today. The next chapter is already underway."}]]}]]}]
